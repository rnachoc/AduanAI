# Local development values only. `make up` copies this file to .env if .env does not exist.
POSTGRES_USER=aduana
POSTGRES_PASSWORD=local-only
GATEWAY_PORT=8780
# Selects a fixed, insecure key: fine on a laptop, never in production (base64 of 32 random bytes there).
ADUANA_MASTER_KEY=local-only
# The first console administrator, created on first start.
ADUANA_ADMIN_EMAIL=admin@example.com
ADUANA_ADMIN_PASSWORD=local-only
