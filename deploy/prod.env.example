# Copy to deploy/prod.env and fill in every value. Never commit the filled file.
# ADUANA_MASTER_KEY: base64 of 32 random bytes, for example `openssl rand -base64 32`.
ADUANA_IMAGE=
POSTGRES_USER=aduana
POSTGRES_PASSWORD=
ADUANA_MASTER_KEY=
ADUANA_ADMIN_EMAIL=
ADUANA_ADMIN_PASSWORD=
ADUANA_UPSTREAMS_FILE=./upstreams.yaml
ADUANA_POLICY_DIR=./policy
GATEWAY_PORT=8080
