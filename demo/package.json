{
  "name": "aduana-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Fake MCP servers, a scripted agent and scenarios to exercise Aduana.",
  "license": "Apache-2.0",
  "author": "Ignacio Rodríguez Caro <rnachoccontact@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
