{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rnachoc/aduana/policy/schema/policy.schema.json",
  "title": "Aduana policy, version 1",
  "description": "Declarative rules with no expression language. See docs/policy-reference.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "rules"],
  "properties": {
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": { "decision": { "const": "deny" } }
    },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "stringMatch": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "not_in": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "effect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "description": { "type": "string", "maxLength": 500 },
        "match": { "$ref": "#/$defs/match" },
        "effect": { "enum": ["allow", "deny", "require_approval"] },
        "obligations": { "$ref": "#/$defs/obligations" },
        "approval": { "$ref": "#/$defs/approval" },
        "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principal": { "$ref": "#/$defs/principal" },
        "tool": { "$ref": "#/$defs/tool" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "context": { "$ref": "#/$defs/context" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/stringMatch" },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stringMatch" } },
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_of"],
          "properties": { "any_of": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "$ref": "#/$defs/stringMatch" },
        "name": { "$ref": "#/$defs/stringMatch" },
        "side_effect": { "type": "boolean" },
        "untrusted_source": { "type": "boolean" },
        "sensitivity": { "$ref": "#/$defs/stringMatch" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flow_from_untrusted": { "type": "boolean" },
        "context_tainted": { "type": "boolean" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "minProperties": 2,
      "properties": {
        "path": { "type": "string", "pattern": "^\\$(\\.[A-Za-z_][A-Za-z0-9_]*|\\[([0-9]+|\\*)\\])*$" },
        "eq": { "type": ["string", "number", "boolean"] },
        "ne": { "type": ["string", "number", "boolean"] },
        "in": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } },
        "not_in": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } },
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "lte": { "type": "number" },
        "matches": { "type": "string", "minLength": 1, "maxLength": 256 },
        "exists": { "type": "boolean" },
        "length_lte": { "type": "integer", "minimum": 0 },
        "any": { "type": "boolean" }
      }
    },
    "detector": { "enum": ["email", "phone_es", "dni_nie", "iban", "card", "secret"] },
    "detectors": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/detector" } },
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redact_result": { "$ref": "#/$defs/detectors" },
        "deny_args_containing": { "$ref": "#/$defs/detectors" },
        "flag_args_containing": { "$ref": "#/$defs/detectors" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvers_group"],
      "properties": {
        "approvers_group": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "expires_in": { "type": "string", "pattern": "^[1-9][0-9]{0,5}(s|m|h)$" }
      }
    }
  }
}
