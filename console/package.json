{
  "name": "aduana-console",
  "version": "0.1.0",
  "private": true,
  "description": "The Aduana web console: activity, approvals, log, catalog, policy and identities.",
  "license": "Apache-2.0",
  "author": "Ignacio Rodríguez Caro <rnachoccontact@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ng build",
    "test": "ng test --watch=false --coverage",
    "lint": "tsc -p tsconfig.app.json --noEmit && eslint . && prettier --check .",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "jsdom": "30.1.3",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
